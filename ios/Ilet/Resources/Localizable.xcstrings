    },
    "home.sendPhotos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos and videos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve video gönder"
          }
        }
      }
    },
    "home.sendTo %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send to %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilecek bilgisayar: %@"
          }
        }
      }
    },
    "home.transfers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarımlar"
          }
        }
      }
    },
    "pairing.cameraDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet needs the camera to scan the pairing code. Allow camera access in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet, eşleştirme kodunu taramak için kameraya ihtiyaç duyar. Ayarlar’dan kamera erişimine izin verin."
          }
        }
      }
    },
    "pairing.cameraUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera is available."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir bir kamera yok."
          }
        }
      }
    },
    "pairing.confirmQuestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with this PC?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayarla eşleştirilsin mi?"
          }
        }
      }
    },
    "pairing.deviceName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone’s name"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’un adı"
          }
        }
      }
    },
    "pairing.deviceNameFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC shows this name."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız bu adı gösterir."
          }
        }
      }
    },
    "pairing.inProgress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştiriliyor…"
          }
        }
      }
    },
    "pairing.pair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştir"
          }
        }
      }
    },
    "pairing.scanAgain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar tara"
          }
        }
      }
    },
    "pairing.scanHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at the QR code on your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerayı bilgisayarınızdaki QR koda doğrultun."
          }
        }
      }
    },
    "pairing.success %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired with %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile eşleştirildi."
          }
        }
      }
    },
    "pairing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with PC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarla eşleştir"
          }
        }
      }
    },
    "security.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC answered with a different identity than the one you paired with, so ilet stopped. Nothing was sent. If you reinstalled ilet on your PC, remove the PC here and pair again. Otherwise, someone on your network may be trying to intercept your files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız, eşleştirdiğiniz kimlikten farklı bir kimlikle yanıt verdiği için ilet durdu. Hiçbir şey gönderilmedi. ilet’i bilgisayarınıza yeniden yüklediyseniz bilgisayarı buradan kaldırıp yeniden eşleştirin. Aksi hâlde ağınızdaki biri dosyalarınızı ele geçirmeye çalışıyor olabilir."
          }
        }
      }
    },
    "security.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security warning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik uyarısı"
          }
        }
      }
    },
    "settings.sendAsJPEG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos as JPG"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları JPG olarak gönder"
          }
        }
      }
    },
    "settings.sendAsJPEGFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows cannot open HEIC photos without an extra app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows, HEIC fotoğrafları ek bir uygulama olmadan açamaz."
          }
        }
      }
    },
