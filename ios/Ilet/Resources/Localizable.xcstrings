{
  "sourceLanguage": "en",
  "strings": {
    "common.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "common.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "common.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "common.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "common.openSettings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarları Aç"
          }
        }
      }
    },
    "desktops.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a PC to send to it. Swipe left to remove it from this iPhone; to remove this iPhone from the PC too, use ilet on the PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndermek istediğiniz bilgisayara dokunun. Bu iPhone’dan kaldırmak için sola kaydırın; bu iPhone’u bilgisayardan da kaldırmak için bilgisayardaki ilet’i kullanın."
          }
        }
      }
    },
    "desktops.pairAnother": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair another PC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir bilgisayar eşleştir"
          }
        }
      }
    },
    "desktops.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili"
          }
        }
      }
    },
    "desktops.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PCs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarlarınız"
          }
        }
      }
    },
    "error.backgroundUploadsBusy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet is still finishing earlier uploads. Try again in a moment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet önceki gönderimleri bitiriyor. Biraz sonra tekrar deneyin."
          }
        }
      }
    },
    "error.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi."
          }
        }
      }
    },
    "error.certificateMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security check failed: this is not the PC you paired with."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik denetimi başarısız: Bu, eşleştirdiğiniz bilgisayar değil."
          }
        }
      }
    },
    "error.desktopUnreachable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC cannot be reached. Make sure ilet is running on it, both devices are on the same Wi-Fi and the PC’s network is set to Private. If you denied Local Network access, allow it in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınıza ulaşılamıyor. ilet’in açık olduğundan, iki cihazın aynı Wi-Fi ağında olduğundan ve bilgisayarın ağ profilinin Özel olduğundan emin olun. Yerel Ağ erişimini reddettiyseniz Ayarlar’dan izin verin."
          }
        }
      }
    },
    "error.fileTooLarge %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is larger than your PC accepts (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya, bilgisayarınızın kabul ettiği boyuttan büyük (%@)."
          }
        }
      }
    },
    "error.fileUnreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be read."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya okunamadı."
          }
        }
      }
    },
    "error.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sorun oluştu. Lütfen tekrar deneyin."
          }
        }
      }
    },
    "error.invalidPairingCode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not an ilet pairing code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir ilet eşleştirme kodu değil."
          }
        }
      }
    },
    "error.notPaired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC no longer accepts this iPhone. Pair it again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız artık bu iPhone’u kabul etmiyor. Yeniden eşleştirin."
          }
        }
      }
    },
    "error.pairingRejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code was not accepted. It may have expired or been used already. Create a new code on your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod kabul edilmedi. Süresi dolmuş ya da kullanılmış olabilir. Bilgisayarınızda yeni bir kod oluşturun."
          }
        }
      }
    },
    "error.server.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC is busy. Try again in a moment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız meşgul. Biraz sonra tekrar deneyin."
          }
        }
      }
    },
    "error.server.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC could not accept the file."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız dosyayı kabul edemedi."
          }
        }
      }
    },
    "error.server.insufficientStorage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC does not have enough free disk space."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınızda yeterli boş disk alanı yok."
          }
        }
      }
    },
    "error.server.payloadTooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is larger than your PC accepts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya, bilgisayarınızın kabul ettiği boyuttan büyük."
          }
        }
      }
    },
    "error.server.tooManyRequests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many failed attempts. Wait a minute and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla başarısız deneme. Bir dakika bekleyip tekrar deneyin."
          }
        }
      }
    },
    "error.storage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet could not save its data on this iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet verilerini bu iPhone’a kaydedemedi."
          }
        }
      }
    },
    "error.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sorun oluştu"
          }
        }
      }
    },
    "error.unexpectedResponse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC sent an unexpected answer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız beklenmeyen bir yanıt gönderdi."
          }
        }
      }
    },
    "error.unsupportedVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC and this iPhone use different versions of ilet. Update both."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız ve bu iPhone farklı ilet sürümleri kullanıyor. İkisini de güncelleyin."
          }
        }
      }
    },
    "error.wrongDesktop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different PC answered. Scan the code again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı bir bilgisayar yanıt verdi. Kodu tekrar tarayın."
          }
        }
      }
    },
    "home.clearFinished": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizle"
          }
        }
      }
    },
    "home.sendFiles": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send files"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya gönder"
          }
        }
      }
    },
    "home.sendPhotos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos and videos"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve video gönder"
          }
        }
      }
    },
    "home.sendTo %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send to %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderilecek bilgisayar: %@"
          }
        }
      }
    },
    "home.transfers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktarımlar"
          }
        }
      }
    },
    "info.how.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet sends photos and files from this iPhone to your PC over your Wi-Fi. They never pass through the internet or a cloud, and you need no account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet, fotoğrafları ve dosyaları bu iPhone’dan Wi-Fi üzerinden bilgisayarınıza gönderir. Dosyalar hiçbir zaman internetten ya da bir buluttan geçmez ve hesap gerekmez."
          }
        }
      }
    },
    "info.how.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straight to your PC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan bilgisayarınıza"
          }
        }
      }
    },
    "info.pairing.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In ilet on your PC, click “Pair new device” and scan the QR code with this iPhone. From then on the two know each other: the connection is encrypted, and only paired devices can send files to your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınızdaki ilet’te “Yeni cihaz eşleştir”e tıklayın ve QR kodu bu iPhone ile tarayın. Bundan sonra iki cihaz birbirini tanır: Bağlantı şifrelenir ve bilgisayarınıza yalnızca eşleştirilmiş cihazlar dosya gönderebilir."
          }
        }
      }
    },
    "info.pairing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair once"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez eşleştirin"
          }
        }
      }
    },
    "info.privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet has no account, no ads and no tracking, and it collects no data. Your files only travel between your iPhone and your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet’te hesap, reklam ve izleme yoktur; ilet hiçbir veri toplamaz. Dosyalarınız yalnızca iPhone’unuz ile bilgisayarınız arasında gider."
          }
        }
      }
    },
    "info.privacy.link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy policy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik politikası"
          }
        }
      }
    },
    "info.privacy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik"
          }
        }
      }
    },
    "info.sending.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Send photos and videos” or “Send files” and choose what to send. In other apps, use Share › ilet. ilet on the PC saves them in Downloads › ilet, unless you chose another folder there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Fotoğraf ve video gönder”e ya da “Dosya gönder”e dokunun ve göndermek istediklerinizi seçin. Diğer uygulamalarda Paylaş › ilet’i kullanın. Bilgisayardaki ilet bunları, orada başka bir klasör seçmediyseniz İndirilenler › ilet klasörüne kaydeder."
          }
        }
      }
    },
    "info.sending.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos and files"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf ve dosya gönderin"
          }
        }
      }
    },
    "info.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How ilet works"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet nasıl çalışır?"
          }
        }
      }
    },
    "info.trouble.localNetwork": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet must be allowed to use the local network on this iPhone: Settings › ilet › Local Network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’da ilet’in yerel ağı kullanmasına izin verilmeli: Ayarlar › ilet › Yerel Ağ."
          }
        }
      }
    },
    "info.trouble.private": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC’s network must be set to Private. If it is Public, ilet on the PC shows how to change that."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarın ağ profili Özel olmalı. Ortak ise bilgisayardaki ilet bunu nasıl değiştireceğinizi gösterir."
          }
        }
      }
    },
    "info.trouble.running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet must be running on the PC. Its icon is next to the clock."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet bilgisayarda çalışıyor olmalı. Simgesi saatin yanında görünür."
          }
        }
      }
    },
    "info.trouble.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your PC cannot be reached"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınıza ulaşılamıyorsa"
          }
        }
      }
    },
    "info.trouble.wifi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices must be on the same Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki cihaz da aynı Wi-Fi ağında olmalı."
          }
        }
      }
    },
    "info.version %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm %@"
          }
        }
      }
    },
    "pairing.cameraDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet needs the camera to scan the pairing code. Allow camera access in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet, eşleştirme kodunu taramak için kameraya ihtiyaç duyar. Ayarlar’dan kamera erişimine izin verin."
          }
        }
      }
    },
    "pairing.cameraUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera is available."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir bir kamera yok."
          }
        }
      }
    },
    "pairing.confirmQuestion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with this PC?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bilgisayarla eşleştirilsin mi?"
          }
        }
      }
    },
    "pairing.deviceName": {
      "localizations": {
