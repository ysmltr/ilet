    "pairing.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with PC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarla eşleştir"
          }
        }
      }
    },
    "security.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PC answered with a different identity than the one you paired with, so ilet stopped. Nothing was sent. If you reinstalled ilet on your PC, remove the PC here and pair again. Otherwise, someone on your network may be trying to intercept your files."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız, eşleştirdiğiniz kimlikten farklı bir kimlikle yanıt verdiği için ilet durdu. Hiçbir şey gönderilmedi. ilet’i bilgisayarınıza yeniden yüklediyseniz bilgisayarı buradan kaldırıp yeniden eşleştirin. Aksi hâlde ağınızdaki biri dosyalarınızı ele geçirmeye çalışıyor olabilir."
          }
        }
      }
    },
    "security.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security warning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenlik uyarısı"
          }
        }
      }
    },
