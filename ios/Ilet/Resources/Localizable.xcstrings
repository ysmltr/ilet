    },
    "welcome.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ilet on your PC, click “Pair new device” and scan the QR code it shows."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınızda ilet’i açın, “Yeni cihaz eşleştir”e tıklayın ve gösterilen QR kodu tarayın."
          }
        }
      }
    },
    "welcome.pair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan pairing code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme kodunu tara"
          }
        }
      }
    },
    "welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos to your PC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları bilgisayarınıza gönderin"
          }
        }
      }
