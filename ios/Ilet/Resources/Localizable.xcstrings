          "stringUnit": {
            "state": "translated",
            "value": "Your PC shows this name."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayarınız bu adı gösterir."
          }
        }
      }
    },
    "pairing.inProgress": {
      "localizations": {
