    "pairing.scanAgain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar tara"
          }
        }
      }
    },
    "pairing.scanHint": {
      "localizations": {
        "en": {
