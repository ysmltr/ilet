    "welcome.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet sends them straight to your Windows PC over your Wi-Fi. No account, no cloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet bunları Wi-Fi üzerinden doğrudan Windows bilgisayarınıza gönderir. Hesap yok, bulut yok."
          }
        }
      }
    },
    "welcome.pair": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan pairing code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme kodunu tara"
          }
        }
      }
    },
    "welcome.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install ilet on your Windows PC and open it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows bilgisayarınıza ilet’i yükleyin ve açın."
          }
        }
      }
    },
    "welcome.step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this iPhone and the PC to the same Wi-Fi. On the PC, the network must be set to Private."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone’u ve bilgisayarı aynı Wi-Fi ağına bağlayın. Bilgisayarda ağ profili Özel olmalıdır."
          }
        }
      }
    },
    "welcome.step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In ilet on the PC, click “Pair new device” and scan the QR code it shows. When the iPhone asks for local network access, allow it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgisayardaki ilet’te “Yeni cihaz eşleştir”e tıklayın ve gösterilen QR kodu tarayın. iPhone yerel ağ erişimi istediğinde izin verin."
          }
        }
      }
    },
    "welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send photos and files to your PC"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları ve dosyaları bilgisayarınıza gönderin"
          }
        }
      }
    }
  },
  "version": "1.0"
