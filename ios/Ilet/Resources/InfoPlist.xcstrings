    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet uses the camera only to scan the pairing QR code shown on your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet, kamerayı yalnızca bilgisayarınızda gösterilen eşleştirme QR kodunu taramak için kullanır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet sends your files directly to your PC over your local network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet, dosyalarınızı yerel ağınız üzerinden doğrudan bilgisayarınıza gönderir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
