{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet uses the camera only to scan the pairing QR code shown on your PC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet, kamerayı yalnızca bilgisayarınızda gösterilen eşleştirme QR kodunu taramak için kullanır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet sends files directly between this iPhone and your PC over your local network."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet, dosyaları yerel ağınız üzerinden doğrudan bu iPhone ile bilgisayarınız arasında gönderir."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet adds a photo or video from your PC to your library only when you tap Save to Photos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ilet, bilgisayarınızdan gelen bir fotoğrafı ya da videoyu yalnızca Fotoğraflar’a kaydet’e dokunduğunuzda arşivinize ekler."
          }
        }
      }
    }
  },
  "version": "1.0"
}
