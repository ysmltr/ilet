{
  "name": "ilet-desktop",
  "productName": "ilet",
  "version": "0.2.1",
  "description": "ilet: Send Files to Your PC",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "build:dev": "tsc -p tsconfig.dev.json",
    "start": "npm run build && electron .",
    "dev:token": "npm run build:dev && electron dist-dev/dev/devServerWithToken.js",
    "dev:pair": "npm run build:dev && electron dist-dev/dev/devPairing.js",
    "dev:app": "npm run build && npm run build:dev && electron dist-dev/dev/devApp.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json && tsc -p src/preload/tsconfig.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "package:dir": "npm run build && electron-builder --dir",
    "package": "npm run build && electron-builder --win nsis",
    "icons": "node scripts/render-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@homebridge/ciao": "1.3.12",
    "qr": "0.7.2"
  }
}
